# Eazzio-School Mobile Environment Configuration Example
# Copy or reference these values when configuring the application.

# Base API URL
# Android Emulator loopback: http://10.0.2.2:5000/api
# iOS Simulator: http://localhost:5000/api
# Physical Device (LAN IP): http://192.168.1.X:5000/api
# Production Server: https://api.eazzioschool.com/api
API_BASE_URL=https://eazzio-school.onrender.com/api/

# Connection Timeouts (milliseconds)
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000

# Optional Sentry / Error Reporting DSN (leave blank for local dev)
SENTRY_DSN=
